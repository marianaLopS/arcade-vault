# Resend (https://resend.com/api-keys) — envío del formulario de contacto en /acerca
RESEND_API_KEY=

# Supabase (https://supabase.com/dashboard/project/wlofsbjzfzywdgvovibv/settings/api)
# Ambas son públicas por diseño: viajan al bundle del navegador y la seguridad
# real la da RLS. La clave `service_role` NO va en este repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Orígenes a los que vuelven los correos de Supabase y OAuth, separados por comas.
# El primero es el de reserva. Deben estar también en Redirect URLs del dashboard.
# Desarrollo + móvil en la LAN: http://localhost:3000,http://192.168.1.37:3000
SITE_URLS=http://localhost:3000
