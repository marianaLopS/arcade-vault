    {
      "id": "s2_body",
      "type": "text",
      "x": -3333.6368880666014,
      "y": 536.4996792825958,
      "width": 1305.4293212890625,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
