      "index": "b30",
      "roundness": null,
      "seed": 556677,
      "version": 426,
      "versionNonce": 67645967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777996945924,
      "link": null,
      "locked": false,
      "text": "\"Agéntica\" = el modelo percibe el entorno, razona y ejecuta acciones\nhasta lograr el objetivo que le diste — sin que tengas que guiarlo paso a paso.",
      "fontSize": 34,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Agéntica\" = el modelo percibe el entorno, razona y ejecuta acciones\nhasta lograr el objetivo que le diste — sin que tengas que guiarlo paso a paso.",
      "autoResize": true,
      "lineHeight": 1.25
