      "updated": 1779213372484,
      "link": null,
      "locked": false,
      "text": "Aislar contexto — cada agente corre en su propia ventana, sin contaminar la\nconversación principal.",
      "fontSize": 20.560824706617282,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aislar contexto — cada agente corre en su propia ventana, sin contaminar la conversación principal.",
